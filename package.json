{
  "name": "tejhq",
  "version": "0.2.0",
  "description": "TypeScript SDK for tej-api: open EOD market data for NSE and BSE.",
  "keywords": ["nse", "bse", "bhavcopy", "ohlcv", "market-data", "india", "stocks", "typescript"],
  "homepage": "https://tejhq.dev",
  "bugs": "https://github.com/tejhq/tej-sdk-ts/issues",
  "repository": { "type": "git", "url": "git+https://github.com/tejhq/tej-sdk-ts.git" },
  "license": "MIT",
  "author": "TejHQ <support@tejhq.dev>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
